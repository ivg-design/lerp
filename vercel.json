{
  "rewrites": [
    {
      "source": "/apps/lerp",
      "destination": "/"
    },
    {
      "source": "/apps/lerp/",
      "destination": "/"
    },
    {
      "source": "/apps/lerp/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
        }
      ]
    }
  ]
}
